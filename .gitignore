# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent instruction files (next dev regenerates AGENTS.md on every run)
/AGENTS.md
/CLAUDE.md

# build output
/out/
/.next/

# wrangler
/.wrangler/

# open-next
/.open-next/
/.dev.vars

# Licensed typeface — kept local, never published with the site source
public/fonts/*
!public/fonts/.gitkeep
