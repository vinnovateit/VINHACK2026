# NextAuth / Auth.js Configuration
AUTH_SECRET= # Generate with: openssl rand -base64 32

# Google OAuth (from Google Cloud Console)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Database Connection (MongoDB via Prisma)
DATABASE_URL= # e.g. mongodb://localhost:27017/vinhack or mongodb+srv://<user>:<password>@cluster.mongodb.net/vinhack?retryWrites=true&w=majority
