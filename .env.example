# NextAuth / Auth.js Configuration
AUTH_SECRET= # Generate with: openssl rand -base64 32 or npx auth secret
AUTH_TRUST_HOST=true # Needed behind reverse proxies (Cloudflare Workers); Vercel sets this automatically

# Google OAuth Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
AUTH_GOOGLE_ID= # e.g. 123456789012-xxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET= # e.g. GOCSPX-xxx

# Database Connection (MongoDB)
DATABASE_URL= # e.g. mongodb+srv://<username>:<password>@cluster0.mongodb.net/vinhack?retryWrites=true&w=majority
